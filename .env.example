# Database (SQLite file, relative to packages/database/prisma/schema.prisma).
# IMPORTANT: for the Next.js runtime, set DATABASE_URL in apps/web/.env to an
# ABSOLUTE path (file:/opt/burger-house-menu/packages/database/prisma/dev.db).
DATABASE_URL="file:./dev.db"

# Local network server
PORT=3000
LAN_IP="192.168.1.50"
LAN_HOST="burgerhouse.local"
BASE_URL="http://localhost:3000"

# Admin credentials (default owner account, change immediately)
ADMIN_EMAIL="admin@burgerhouse.local"
ADMIN_PASSWORD="change-me-strong-password"

# Session secret (generate with: openssl rand -base64 32)
ADMIN_SESSION_SECRET="replace-with-openssl-rand-base64-32"

# Uploads
UPLOAD_DIR="./public/uploads"
MAX_UPLOAD_SIZE_MB=5

# App
NEXT_PUBLIC_APP_NAME="Burger House"
NEXT_PUBLIC_CURRENCY="ETB"
NEXT_PUBLIC_DEFAULT_LOCALE="en"
NEXT_PUBLIC_SUPPORTED_LOCALES="en,am"
